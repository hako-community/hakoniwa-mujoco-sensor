{
  "$schema": "./a2-sensor-manifest.schema.json",
  "name": "drone_a2_sensors",
  "description": "Forward 60 deg radar with the distance-dependent detection model switched on. detection_reference_range is the distance out to which a ray that hits is always reported; beyond it the probability falls as (ref/R)^2, which combined with the sampler's own 1/R^2 gives the radar equation's 1/R^4. A big target still intercepts many more rays, so it stays detectable much further out -- which is what the geometric-only model could not express.",
  "pdu_robot": "Drone",
  "components": [
    {
      "id": "front_lidar",
      "kind": "sensor",
      "type": "lidar_3d",
      "pdu_name": "lidar_points",
      "mount": {
        "x": 0.15,
        "y": 0.0,
        "z": 0.0,
        "yaw_deg": 0.0
      },
      "params": {
        "frame_id": "front_lidar_frame",
        "channels": 15,
        "rotations_per_second": 10,
        "points_per_second": 54150,
        "max_distance": 20.0,
        "min_distance": 0.05,
        "vertical_fov_lower_deg": -15.0,
        "vertical_fov_upper_deg": 15.0,
        "horizontal_fov_start_deg": -180.0,
        "horizontal_fov_end_deg": 180.0
      }
    },
    {
      "id": "safety_scan",
      "kind": "sensor",
      "type": "lidar_2d",
      "pdu_name": "scan",
      "mount": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0,
        "yaw_deg": 0.0
      },
      "params": {
        "frame_id": "scan_frame",
        "angle_min_deg": -180.0,
        "angle_max_deg": 180.0,
        "angle_increment_deg": 1.0,
        "range_min": 0.05,
        "range_max": 20.0,
        "scan_frequency_hz": 10
      }
    },
    {
      "id": "front_radar",
      "kind": "sensor",
      "type": "radar",
      "pdu_name": "radar_scan",
      "mount": {
        "x": 0.15,
        "y": 0.0,
        "z": 0.0,
        "yaw_deg": 0.0
      },
      "params": {
        "frame_id": "front_radar_frame",
        "range": 20.0,
        "horizontal_fov_deg": 60.0,
        "vertical_fov_deg": 20.0,
        "points_per_second": 1500,
        "noise_seed": 1,
        "detection_reference_range": 6.0,
        "detection_falloff_exp": 2.0
      }
    }
  ]
}
