{
  "_note": [
    "RS-7 preset: D435i above a bin of metal work pieces (examples/realsense_binpicking).",
    "Every effect is ON. Values marked as assumptions in docs/physical_ai/realsense_camera.md.",
    "Thermal: cold start in a 20 C hall (factory calibration is warm at 25 C)."
  ],
  "model": "D435i",
  "frame_id": "bin_camera",
  "depth": { "width": 848, "height": 480, "fps": 30, "format": "DEPTH_F32_M" },
  "rgb": { "enabled": true, "width": 1280, "height": 720, "fps": 30, "format": "R8G8B8" },
  "depth_model": { "enabled": true, "noise_model": "typical", "seed": 1 },
  "rolling_shutter": { "enabled": true },
  "edge_effects": { "enabled": true, "occlusion": true,
                    "flying_pixels": { "enabled": true, "window_px": 7, "jump_ratio": 0.05, "probability": 0.5 },
                    "seed": 2 },
  "texture_model": { "enabled": true, "materials": "materials.json", "laser_power_mw": 150, "ambient_ir": 0.1,
                     "seed": 3 },
  "specular_model": { "enabled": true, "highlight_width_deg": 8, "interreflection": true, "max_distance_m": 0.5,
                      "ray_stride_px": 4, "min_specular": 0.5, "mirror_gain": 1.0, "seed": 4 },
  "thermal": { "enabled": true, "ambient_c": 20.0, "start_warm": false, "seed": 5 },
  "exposure": { "enabled": true, "auto": true,
                "motion_blur": { "enabled": true, "subframes": 4, "disparity_spread_px": 1.0 }, "seed": 6 },
  "post_processing": { "enabled": false },
  "imu": { "enabled": true, "accel_rate_hz": 250, "gyro_rate_hz": 400, "bias_mode": "calibrated", "seed": 7 },
  "imu_timing": { "enabled": true, "jitter_s": 0.0001, "misalignment_deg": 0.5, "seed": 8 },
  "frame_timing": { "enabled": false }
}
