{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwa.dev/schemas/sensor-profile-v1.schema.json",
  "title": "Hakoniwa sensor profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "kind", "provenance", "basis", "units", "parameters"],
  "properties": {
    "schema_version": { "const": "sens005-v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["truth", "datasheet", "fitted", "randomized"] },
    "provenance": { "enum": ["assumed", "datasheet", "measured", "fitted"] },
    "basis": { "type": "string", "minLength": 1 },
    "units": { "const": "SI" },
    "parameters": { "type": "object" },
    "seed": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "device_model": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "fit": {
      "type": "object",
      "required": ["source_log_sha256", "holdout_report_sha256", "tool_version"],
      "properties": {
        "source_log_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "holdout_report_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "tool_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "truth" } }, "required": ["kind"] },
      "then": { "properties": { "provenance": { "const": "assumed" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "datasheet" } }, "required": ["kind"] },
      "then": {
        "required": ["source"],
        "properties": {
          "provenance": { "const": "datasheet" },
          "source": { "required": ["uri", "sha256", "device_model", "retrieved_at"] }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "fitted" } }, "required": ["kind"] },
      "then": {
        "required": ["fit"],
        "properties": { "provenance": { "const": "fitted" } }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "randomized" } }, "required": ["kind"] },
      "then": { "required": ["seed"] }
    }
  ],
  "additionalProperties": false
}

