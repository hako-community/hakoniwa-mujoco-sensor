<mujoco model="s5_static_pillar">
  <compiler angle="degree"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="160" offheight="90"/>
    <map znear="0.01" zfar="10"/>
  </visual>
  <worldbody>
    <geom name="floor" type="box" size="6 6 0.05" pos="0 0 -0.05"
          rgba="0.6 0.6 0.6 1"/>
    <geom name="pillar" type="box" size="0.4 0.4 1.0" pos="2 0 1"
          rgba="0.85 0.3 0.3 1"/>
    <!-- Camera looks along world +X. Image right is world -Y; up is +Z. -->
    <camera name="s5_camera" pos="0 0 1" xyaxes="0 -1 0 0 0 1" fovy="60"/>
  </worldbody>
</mujoco>
