<mujoco model="m6_world">
  <!-- M6 end-to-end env: a single pillar 2 m in front of the drone start (+X),
       open on both Y sides so the drone can steer around it. Frame: envsim
       ROS==MuJoCo (X=forward/North, Y=left/West, Z=Up). Drone start = origin,
       goal = (4,0,H). Pillar center MuJoCo (2,0) is the ground-truth obstacle. -->
  <size nstack="40000000" nconmax="500000" />
  <worldbody>
    <body name="body_floor" pos="0 0 0">
      <geom name="geom_floor" type="box" size="6 6 0.05" pos="0 0 0.05" euler="0 0 0" rgba="0.6 0.6 0.6 1" contype="1" conaffinity="0" />
    </body>
    <body name="body_pillar_front" pos="0 0 0">
      <geom name="geom_pillar_front" type="box" size="0.4 0.4 1.0" pos="2 0 1.0" euler="0 0 0" rgba="0.85 0.3 0.3 1" contype="1" conaffinity="0" />
    </body>
  </worldbody>
</mujoco>
